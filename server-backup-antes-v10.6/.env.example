# ==========================================
# PAMONHA NET FIDELIDADE — CONFIGURAÇÕES
# ==========================================

# MongoDB Atlas ou local
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/pamonha_net?retryWrites=true&w=majority

# Segredo para assinar JWTs (mínimo 32 caracteres)
JWT_SECRET=coloque_aqui_um_segredo_forte_de_no_minimo_32_caracteres

# URL do frontend (CORS)
CLIENT_URL=http://localhost:5000

# Cores do QR Code (opcional — fallback para paleta rural)
QR_COLOR_DARK=#5D4037
QR_COLOR_LIGHT=#FFFDE7

# Porta da API
PORT=5000

# ==========================================
# NOTIFICAÇÕES PUSH (Web Push) — envia aviso real para o celular do cliente
# Gere um par próprio com: npx web-push generate-vapid-keys
# Se preferir gerar o seu próprio, rode: npx web-push generate-vapid-keys
# ==========================================
VAPID_PUBLIC_KEY=BPPdi49odUPad9vUBLoucjvakbUE0RdBFL6Z5ZXT9By5-hbUq80ekMZUkNv_Vdz2gXqZRly4pwzujsROqB6ogrM
VAPID_PRIVATE_KEY=coloque_aqui_a_chave_privada_gerada
VAPID_SUBJECT=mailto:contato@pamonhanet.com.br

# ==========================================
# ==========================================
# E-MAIL (recuperação de senha) — Brevo via API HTTP
# Crie uma API key no painel do Brevo e coloque-a no Render.
# O endereço EMAIL_FROM precisa estar autorizado/verificado no Brevo.
# ==========================================
BREVO_API_KEY=
EMAIL_FROM=pamonhanet@gmail.com
EMAIL_FROM_NAME=Pamonha Net
