# Renomeie este arquivo para ".env" e preencha com os seus valores reais.
# NUNCA suba o arquivo ".env" real para o GitHub ou qualquer repositório público.

# String de conexão do MongoDB Atlas (veja o README para o passo a passo)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/pamonha-net?retryWrites=true&w=majority

# Chave secreta usada para assinar os tokens JWT. Use uma string longa e aleatória.
JWT_SECRET=troque_por_uma_chave_secreta_bem_forte_e_aleatoria

# Porta em que o servidor Express vai rodar
PORT=5000

# URL do frontend, usada para configurar o CORS corretamente em produção
CLIENT_URL=http://localhost:5000

# Recálculo automático diário dos segmentos CRM
ENABLE_SEGMENT_CRON=true
